# Database (dev + separate test database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/shipping"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5434/shipping_test"

# Business settings
HOME_COUNTRY="US"
CURRENCY="USD"
APP_URL="http://localhost:3000"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"

# Seeded admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"


# Email (optional; logs to console when empty)
RESEND_API_KEY=""
EMAIL_FROM="KingstonFreight <noreply@example.com>"

# E2E only
E2E_TEST_MODE=""
COMPANY_NAME="KingstonFreight"

# Proxy trust for rate limiting: Vercel is detected automatically. Self-hosted behind ONE reverse proxy → "1".
TRUST_PROXY=""

# City lookup for the tracking globe (OpenStreetMap Nominatim; sends only city + country). "off" to disable.
GEOCODE_PROVIDER="nominatim"

# Legal & contact pages (shown on /terms, /privacy, /refunds, /contact). Unset values are omitted.
COMPANY_LEGAL_NAME="KingstonFreight LLC"
COMPANY_ADDRESS=""
SUPPORT_EMAIL=""
SUPPORT_PHONE=""
GOVERNING_STATE=""

# Crypto wallet funding
BTC_ADDRESS=""
LTC_ADDRESS=""
MIN_TOPUP_USD="50"
# Explorer + price lookups for submitted transactions ("off" disables)
CHAIN_LOOKUP="on"
