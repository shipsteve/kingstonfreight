generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ZoneKind {
  DOMESTIC
  INTERNATIONAL
}

enum ServiceType {
  PARCEL
  COURIER
  FREIGHT
}

enum QuoteStatus {
  PENDING_REVIEW
  PRICED
  ACCEPTED
  EXPIRED
  DECLINED
}

enum ShipmentStatus {
  BOOKED
  PICKED_UP
  IN_TRANSIT
  CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
  REROUTING
}

enum PaymentMethod {
  BALANCE
  COUNTER
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum AccountStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum LedgerKind {
  TOPUP
  BOOKING
  REFUND
  ADJUSTMENT
}

enum Coin {
  BTC
  LTC
}

enum TopUpMethod {
  MANUAL
}

enum TopUpStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum TransportMode {
  AIR
  SEA
  ROAD
}

enum BillTo {
  SENDER
  RECIPIENT
  THIRD_PARTY
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  passwordHash    String
  role            Role          @default(CUSTOMER)
  company         String?
  phone           String?
  accountStatus   AccountStatus @default(PENDING)
  approvedAt      DateTime?
  approvedById    String?
  termsAcceptedAt DateTime?
  createdAt       DateTime      @default(now())
  quotes          Quote[]
  shipments       Shipment[]
  ledgerEntries   LedgerEntry[]
  topUps          TopUp[]
}

/// Append-only. Balance = SUM(amountCents) per user.
model LedgerEntry {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  amountCents Int
  kind        LedgerKind
  topUpId     String?    @unique
  topUp       TopUp?     @relation(fields: [topUpId], references: [id])
  shipmentId  String?
  shipment    Shipment?  @relation(fields: [shipmentId], references: [id])
  note        String?
  createdById String?
  createdAt   DateTime   @default(now())

  @@unique([shipmentId, kind])
  @@index([userId])
}

model TopUp {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  method         TopUpMethod  @default(MANUAL)
  coin           Coin
  txHash         String
  requestedCents Int
  creditedCents  Int?
  status         TopUpStatus  @default(PENDING_REVIEW)
  chainCheck     Json?
  adminNote      String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  ledgerEntry    LedgerEntry?

  @@unique([coin, txHash])
  @@index([status])
  @@index([userId])
}

model Zone {
  id               String       @id @default(cuid())
  name             String       @unique
  kind             ZoneKind
  postcodePrefixes String[]
  countryCodes     String[]
  originRates      ParcelRate[] @relation("OriginZone")
  destRates        ParcelRate[] @relation("DestZone")
}

model ParcelRate {
  id           String @id @default(cuid())
  originZoneId String
  destZoneId   String
  maxWeightKg  Float
  priceCents   Int
  originZone   Zone   @relation("OriginZone", fields: [originZoneId], references: [id])
  destZone     Zone   @relation("DestZone", fields: [destZoneId], references: [id])

  @@unique([originZoneId, destZoneId, maxWeightKg])
}

model CourierRate {
  id           String @id @default("singleton")
  baseFeeCents Int
  perKmCents   Int
  maxKm        Float
}

model Quote {
  id             String      @id @default(cuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  serviceType    ServiceType
  origin         Json
  destination    Json
  packages       Json
  distanceKm     Float?
  freightDetails Json?
  priceCents     Int?
  status         QuoteStatus
  adminNote      String?
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  shipment       Shipment?

  @@index([userId])
  @@index([status])
}

model Shipment {
  id                 String          @id @default(cuid())
  quoteId            String?         @unique
  quote              Quote?          @relation(fields: [quoteId], references: [id])
  userId             String?
  user               User?           @relation(fields: [userId], references: [id])
  /// Admin orders for someone without an account yet; claimed when that email registers.
  customerEmail      String?
  /// sha256 of a one-time link emailed to customerEmail; proves inbox ownership before linking to an account.
  claimTokenHash     String?         @unique
  createdById        String?
  trackingNumber     String          @unique
  serviceType        ServiceType
  status             ShipmentStatus
  priceCents         Int
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus   @default(UNPAID)
  origin             Json
  destination        Json
  transportMode      TransportMode?
  departurePort      String?
  arrivalPort        String?
  departureDate      DateTime?
  estimatedArrival   DateTime?
  /// Door delivery to the recipient (arrival = at the airport/port).
  estimatedDelivery  DateTime?
  nextStop           String?
  packages           Json?
  actualWeightKg     Float?
  chargeableWeightKg Float?
  contents           String?
  declaredValueCents Int?
  goodsOriginCountry String?
  hsCode             String?
  billTo             BillTo?
  // Geocoded city positions for the tracking globe; null → fall back to country centroid.
  originLat          Float?
  originLng          Float?
  destLat            Float?
  destLng            Float?
  createdAt          DateTime        @default(now())
  events             TrackingEvent[]
  ledgerEntries      LedgerEntry[]

  @@index([userId])
  @@index([status])
  @@index([customerEmail])
}

model TrackingEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  location    String
  countryCode String?
  note        String?
  lat         Float?
  lng         Float?
  confirmedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([shipmentId])
}
